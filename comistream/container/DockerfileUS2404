# ベースイメージとしてUbuntu Server 24.04 LTSを使用
FROM ubuntu:24.04

# タイムゾーンを日本に設定
ENV TZ Asia/Tokyo
ENV DEBIAN_FRONTEND noninteractive

COPY /comistream-tools/7zz /usr/local/bin/
COPY /comistream-tools/cpdf /usr/local/bin/
COPY /comistream-tools/ffmpeg /usr/local/bin/
COPY /comistream-tools/ImageMagick--clang-x86_64-7.1.1-23-patch.tar.xz /tmp/
COPY /comistream-tools/comistream.tar.gz /tmp/comistream.tar.gz
# システムの更新と必要なパッケージのインストール
# Ubuntuにphp-zstdがない
# sudo apt install software-properties-common curl -y
# sudo add-apt-repository ppa:ondrej/php
# sudo apt update
# sudo apt install php-zstd
# php8.4になる
# apt-get install -y tar apache2 php8.3 php8.3-fpm php8.3-cli libsqlite3-dev zstd libzstd-dev ghostscript rsyslog logrotate cron php8.3-intl && \
RUN apt-get update && \
    apt-get install -y tzdata && \
    ln -sf /usr/share/zonsudo apt install software-properties-common curl -yeinfo/Asia/Tokyo /etc/localtime && \
    echo "Asia/Tokyo" > /etc/timezone && \
    dpkg-reconfigure --frontend noninteractive tzdata && \
    apt-get install -y tar apache2  libsqlite3-dev zstd libzstd-dev ghostscript rsyslog logrotate cron  && \
    apt-get install -y b3sum  cifs-utils unzip imagemagick libavif-dev poppler-utils fontconfig unrar fd-find libmupdf-dev && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    useradd -m user && \
    sed -i 's/audio\/x-flac\s*flac/audio\/flac\t\tflac/' /etc/mime.types && \
    tar xvaf /tmp/ImageMagick--clang-x86_64-7.1.1-23-patch.tar.xz -C /usr/local/bin && \
    rm -rf /tmp/ImageMagick--clang-x86_64-7.1.1-23-patch.tar.xz && \
    ls -lhtr /usr/local/bin/ && \
    chmod 755 /usr/local/bin/ImageMagick--clang-x86_64-7.1.1-23-patch/AppRun && \
    ln -s /usr/local/bin/ImageMagick--clang-x86_64-7.1.1-23-patch/AppRun /usr/local/bin/magick && \
    mkdir -p /home/user/comistream && \
    tar -xzvf /tmp/comistream.tar.gz -C /home/user/comistream --strip-components=1 && \
    rm /tmp/comistream.tar.gz && \
    mkdir -p /home/user/comistream/data && \
    # chgrp -R www-data /home/user/comistream/data/ && \
    chown -R www-data:www-data /home/user/comistream/data/ && \
    chmod -R 775 /home/user/comistream/data/ && \
    chmod 775 /home/user && chgrp www-data /home/user && \
    mkdir -p /usr/lib/cgi-bin && \
    ln -s /home/user/comistream/code/comistream.php /usr/lib/cgi-bin/ && \
    ln -s /home/user/comistream/code/livestream.php /usr/lib/cgi-bin/ && \
    mkdir -p /home/user/public/nas && \
    chgrp www-data -R /home/user/public && \
    chmod 775 /home/user/public && \
    echo "Redirect 302 / /cgi-bin/comistream.php" > /home/user/public/.htaccess && \
    chmod 666 /home/user/public/.htaccess && \
    chmod 755 /home/user/comistream/cron/cron_comistream_daily.sh && \
    ln -s /home/user/comistream/cron/cron_comistream_daily.sh /etc/cron.daily/ && \
    mkdir -p /usr/etc/ImageMagick-7 && \
    cp /home/user/comistream/rsrc/IM7/policy.xml /usr/etc/ImageMagick-7/policy.xml && \
    # テスト用コード
    # ln -s /home/user/comistream/cron/cron_comistream_daily.sh /etc/cron.hourly/ && \
    rm -f /etc/apache2/sites-enabled/000-default.conf && \
    mkdir -p /run/php && \
    chown www-data:www-data /run/php && \
    chmod 755 /run/php && \
    mkdir -p /var/cache/fontconfig && \
    chmod 777 /var/cache/fontconfig && \

    # PHP-FPMの設定を変更(from [#11])
    sed -i "s|listen = /run/php/php8.3-fpm.sock|listen = 9000|g" /etc/php/8.3/fpm/pool.d/www.conf && \
    sed -i "s|^listen.acl_users|;listen.acl_users|g" /etc/php/8.3/fpm/pool.d/www.conf && \
    sed -i "s|^listen.acl_groups|;listen.acl_groups|g" /etc/php/8.3/fpm/pool.d/www.conf && \

    # Apacheの設定を変更(from [#11])
    a2enmod rewrite && \
    a2enmod cgi && \
    a2enmod proxy_fcgi && \
    echo "<IfModule mod_proxy_fcgi.c>" > /etc/apache2/conf-available/php8.3-fpm.conf && \
    echo "    <FilesMatch \\.php$>" >> /etc/apache2/conf-available/php8.3-fpm.conf && \
    echo "        SetHandler \"proxy:fcgi://localhost:9000\"" >> /etc/apache2/conf-available/php8.3-fpm.conf && \
    echo "    </FilesMatch>" >> /etc/apache2/conf-available/php8.3-fpm.conf && \
    echo "</IfModule>" >> /etc/apache2/conf-available/php8.3-fpm.conf && \
    a2enconf php8.3-fpm && \

    # 権限変更(from [#11])上でやっている
    # chown -R www-data:www-data /home/user/comistream/data && \
    # chmod -R 755 /home/user/comistream/data && \

    echo '#!/bin/bash' > /start.sh && \
    echo 'trap "echo Shutting down...; kill -TERM \$(jobs -p) 2>/dev/null" SIGTERM SIGINT' >> /start.sh && \
    echo 'mkdir -p /var/log/php8.3-fpm' >> /start.sh && \
    echo 'mkdir -p /var/log/sssd' >> /start.sh && \
    echo 'mkdir -p /var/log/anaconda' >> /start.sh && \
    echo 'mkdir -p /var/log/private' >> /start.sh && \
    echo 'mkdir -p /var/log/samba' >> /start.sh && \
    echo 'mkdir -p /var/log/apache2' >> /start.sh && \
    echo 'mkdir -p /var/log/audit' >> /start.sh && \
    echo 'cron' >> /start.sh && \
    echo '/usr/sbin/php-fpm8.3 &' >> /start.sh && \
    echo 'php /home/user/comistream/code/intstallThemeDir.php' >> /start.sh && \
    echo '/usr/sbin/apache2ctl -D FOREGROUND &' >> /start.sh && \
    echo 'wait' >> /start.sh && \
    chmod +x /start.sh

