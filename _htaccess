# Comistream - PHP Directory Listing
# This file should be deployed as .htaccess in the DocumentRoot.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Do not rewrite for special aliased paths.
  # This rule prevents rewrite loops by exiting early for the target script and asset paths.
  RewriteRule ^(cgi-bin/|theme/|bibi/) - [L]

  # For requests that do not correspond to an existing file...
  RewriteCond %{REQUEST_FILENAME} !-f
  # ...rewrite the request to the main directory listing script.
  # This will handle both directory listings and custom 404 pages for non-files.
  RewriteRule ^(.*)$ /cgi-bin/dir_list.php?path=$1 [L,QSA]
</IfModule>

# General settings
ErrorDocument 404 /theme/icons/now-printing.gif
FileETag None

<IfModule mod_headers.c>
    Header always unset ETag "expr=%{REQUEST_STATUS} == 404"
    Header always set Cache-Control "max-age=0, no-cache, no-store, must-revalidate" "expr=%{REQUEST_STATUS} == 404"
    Header always set Pragma "no-cache" "expr=%{REQUEST_STATUS} == 404"
    Header always set Expires "Wed, 11 Jan 1984 05:00:00 GMT" "expr=%{REQUEST_STATUS} == 404"
</IfModule>

# Custom MIME TYPES
AddType audio/flac .flac
