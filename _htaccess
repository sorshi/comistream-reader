# Comistream - PHP Directory Listing
# This file should be deployed as .htaccess in the DocumentRoot.

# Enable directory listing to allow mod_rewrite to work

# Note: AllowEncodedSlashes and UnsafeAllow3F must be set in Apache config files (httpd.conf or virtual host), not in .htaccess

# Force Apache to allow directory access
<RequireAll>
  Require all granted
</RequireAll>

<IfModule mod_rewrite.c>
  RewriteEngine On
  DirectoryIndex index.php index.html

  # Do not rewrite for special aliased paths.
  # Exclude covers and preview from theme protection
  RewriteRule ^(cgi-bin/|bibi/) - [L]
  RewriteRule ^theme/(?!covers/|preview/) - [L]

  # Do not rewrite if the request is for an existing file.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # For directories, rewrite to the listing script ONLY if an index file does not exist.
  # Force rewrite for all directories that don't have index files
  # Security: Only respect index files in the document root, ignore all subdirectory index files
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !^/$
  RewriteCond %{THE_REQUEST} \s/+(.+?)[\s?] [NC]
  RewriteRule ^ /cgi-bin/dir_list.php?path=%1 [L,QSA,E=no-gzip:1]

  # ----------------------------------------------------------------------
  # 1. 書影パス (/theme/covers/) と プレビューパス (/theme/preview/) でファイルが存在しない場合
  # ----------------------------------------------------------------------
  # Missing cover/preview images - respond with 404 (body will be set via ErrorDocument)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^theme/(covers|preview)/ - [L,R=404]

  # ----------------------------------------------------------------------
  # 2. 上記以外で、ファイルもディレクトリも存在しない場合
  # ----------------------------------------------------------------------
  # ここで初めて dir_list.php に渡すルールを適用する
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ /cgi-bin/dir_list.php?path=$1 [L,QSA]

  # ----------------------------------------------------------------------
  # グローバルなErrorDocument設定は不要になるか、汎用的なものを指定
  # ErrorDocument 404 /theme/icons/now-printing.gif # ← この行は不要になる
  # ----------------------------------------------------------------------

</IfModule>

# Scoped ErrorDocument for covers/preview 404s only
<If "%{REQUEST_URI} =~ m#^/theme/(covers|preview)/#">
  ErrorDocument 404 /theme/icons/now-printing.gif
</If>

# General settings
# ErrorDocument 404 /theme/icons/now-printing.gif
FileETag None

<IfModule mod_headers.c>
    Header always unset ETag "expr=%{REQUEST_STATUS} == 404"
    Header always set Cache-Control "max-age=0, no-cache, no-store, must-revalidate" "expr=%{REQUEST_STATUS} == 404"
    Header always set Pragma "no-cache" "expr=%{REQUEST_STATUS} == 404"
    Header always set Expires "Wed, 11 Jan 1984 05:00:00 GMT" "expr=%{REQUEST_STATUS} == 404"
</IfModule>

# Custom MIME TYPES for Audio
AddType audio/flac .flac
AddType audio/mpeg .mp3
AddType audio/mp4 .m4a
AddType audio/aac .aac
AddType audio/x-aiff .aiff .aif
AddType audio/wav .wav .wave
AddType audio/ogg .ogg .oga
AddType audio/x-ms-wma .wma
